# Copy to .env.local and fill with your EmailJS credentials
# React only exposes vars prefixed with REACT_APP_
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
REACT_APP_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id

# Optional legacy endpoint fallback (not used when EmailJS is configured)
# REACT_APP_BOOKING_EMAIL_ENDPOINT=https://your-backend.example.com/api/send-booking
